# ════════════════════════════
# FREE LLM PROVIDERS
# ════════════════════════════

# Groq (FREE — 30 req/min, Llama 3.3 70B)
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# Google Gemini (FREE — 15 req/min, Gemini 2.0 Flash)
GEMINI_API_KEY=AIzaxxxxxxxxxx

# Cloudflare Workers AI (FREE — 100K req/day)
CF_ACCOUNT_ID=your_account_id
CF_API_TOKEN=your_api_token

# Ollama (optional — local dev only)
OLLAMA_URL=http://localhost:11434

# ════════════════════════════
# DATABASE (Neon — FREE 512MB)
# ════════════════════════════

DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/luxor9?sslmode=require

# ════════════════════════════
# CACHE (Upstash — FREE 10K/day)
# ════════════════════════════

UPSTASH_REDIS_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_TOKEN=AXxxxxxxxxxxxx

# ════════════════════════════
# STORAGE (Cloudflare R2 — FREE 10GB)
# ════════════════════════════

R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=luxor9-files
R2_PUBLIC_URL=https://files.luxor9.your-domain.com

# ════════════════════════════
# APP
# ════════════════════════════

SECRET_KEY=generate-a-random-64-char-string-here
WORKSPACE_ROOT=/data/workspaces
MAX_AGENT_TURNS=80
MAX_SANDBOXES=3
CORS_ORIGINS=https://luxor9.vercel.app,http://localhost:3000

# ════════════════════════════
# FUNDRAISING OS — outreach email (SMTP) + autonomous follow-ups
# ════════════════════════════

# SMTP for sending cold emails & scheduled follow-ups (e.g. Gmail, Mailtrap, SES).
# For Gmail use an App Password and SMTP_HOST=smtp.gmail.com SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=founder@luxor9.ai
FOUNDER_EMAIL=you@example.com

# Master switch. When false (default), outreach is DRAFTED but never auto-sent —
# approve in the dashboard. Set true (with SMTP above) to enable autonomous sending.
AUTO_SEND=false

# How often the follow-up scheduler checks for due, approved outreach (minutes).
FOLLOWUP_INTERVAL_MIN=30
